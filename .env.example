# ============================================================
# CHMSU E-Clearance - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ============================================================
# Database (TiDB Cloud)
# ============================================================
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=chmsu_eclearance_campus_2024
DB_USER=your_tidb_username.root
DB_PASSWORD=your_tidb_password
DB_CHARSET=utf8mb4

# ============================================================
# Application
# ============================================================
APP_NAME="CHMSU E-Clearance"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-app.onrender.com
APP_TIMEZONE=Asia/Manila

# ============================================================
# Session
# ============================================================
SESSION_SECRET=change_this_to_random_string
SESSION_LIFETIME=120
SESSION_NAME=chmsu_eclearance_session

# ============================================================
# Email (Gmail SMTP)
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=noreply@chmsu.edu.ph
MAIL_FROM_NAME="CHMSU E-Clearance"
MAIL_ENCRYPTION=tls

# ============================================================
# OAuth (Google)
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/index.php?google_callback=1

# ============================================================
# File Uploads
# ============================================================
UPLOAD_DIR=uploads/
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# ============================================================
# Security
# ============================================================
CSRF_SECRET=change_this_to_random_string
BCRYPT_COST=10

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=error
LOG_DIR=logs/

# ============================================================
# TiDB SSL (optional)
# ============================================================
DB_SSL_MODE=require